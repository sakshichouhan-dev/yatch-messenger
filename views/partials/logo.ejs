<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link rel="stylesheet" href="/public/style.css">
</head>
<body>
  <div class="brand" style="display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 1.25rem; color: #0f172a; margin-bottom: 20px;">
  <svg width="32" height="32" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Rounded chat-bubble backdrop -->
    <rect width="36" height="36" rx="10" fill="#0284c7"/>
    
    <!-- Messenger stylized 'Y' intersecting shapes -->
    <path d="M11 11L18 19L25 11" stroke="white" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M18 19V26" stroke="white" stroke-width="3.2" stroke-linecap="round"/>
    
    <!-- Unread ping / active notification dot -->
    <circle cx="26" cy="10" r="3" fill="#38bdf8" stroke="#0284c7" stroke-width="1.5"/>
  </svg>
  <span>Yutch</span>
</div>
</body>
</html>