<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Yutch Messenger</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body class="dashboard-wrapper" data-user-email="<%= email %>">

  <div class="messenger-app">
    <!-- 1. Left Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-top">
        <div class="app-brand">
          <span class="brand-logo">Y</span>
          <span class="brand-name">Yutch</span>
        </div>

        <div class="user-badge">
          <div class="user-avatar"><%= email.charAt(0).toUpperCase() %></div>
          <div class="user-details">
            <span class="user-email"><%= email %></span>
            <span class="status-indicator">● Active Now</span>
          </div>
        </div>

        <div class="channels-section">
          <span class="channels-title">CHANNELS</span>
          <div class="channel-item active">
            <span class="channel-hash">#</span>
            <div class="channel-info">
              <span class="channel-title">Global Chat</span>
              <span class="channel-desc">Main public room</span>
            </div>
          </div>
        </div>
      </div>

      <div class="sidebar-bottom">
        <a href="/logout" class="sign-out-link">Sign Out</a>
      </div>
    </aside>

    <!-- 2. Main Chat Area -->
    <main class="chat-window">
      <!-- Chat Header -->
      <header class="chat-window-header">
        <h2># Global Chat</h2>
      </header>

      <!-- Message Bubbles Container (Single Container Only) -->
      <section class="chat-message-stream" id="chatStream">
        <div class="msg-row received">
          <span class="msg-sender">System</span>
          <div class="msg-text">Welcome to Yutch Messenger! Type below to chat with team members.</div>
        </div>
      </section>

      <!-- Typing Indicator -->
      <div id="typingNotice" class="typing-indicator" style="display: none;">
        <span id="typingUser">Someone</span> is typing...
      </div>

      <!-- Footer Form -->
      <footer class="chat-window-footer">
        <form id="chatForm" class="message-input-form">
          <input 
            type="text" 
            id="chatInput" 
            placeholder="Type a message..." 
            autocomplete="off" 
            required 
          />
          <button type="submit" class="send-btn">Send</button>
        </form>
      </footer>
    </main>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script src="/script.js"></script>
</body>
</html>